<!doctype html>
<html lang="en">

    <%- include('./partials/head') %>

  <body data-spy="scroll" data-target=".site-navbar-target" data-offset="300">

    <div class="site-wrap" id="home-section">

      <div class="site-mobile-menu site-navbar-target">
        <div class="site-mobile-menu-header">
          <div class="site-mobile-menu-close mt-3">
            <span class="icon-close2 js-menu-toggle"></span>
          </div>
        </div>
        <div class="site-mobile-menu-body"></div>
      </div>

      <%- include('./partials/topbar') %>

    <div class="ftco-blocks-cover-1">
      <div class="ftco-cover-1 overlay" style="background-image: url('/customer-assets/images/home-velfire.jpg')">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-lg-5">
              <div class="feature-car-rent-box-1">
                <h3>Toyota Vellfire</h3>
                <ul class="list-unstyled">
                  <li>
                    <span>Doors</span>
                    <span class="spec">4</span>
                  </li>
                  <li>
                    <span>Seats</span>
                    <span class="spec">6</span>
                  </li>
                  <li>
                    <span>Luggage</span>
                    <span class="spec">2 Suitcase/2 Bags</span>
                  </li>
                  <li>
                    <span>Transmission</span>
                    <span class="spec">Automatic</span>
                  </li>
                  <li>
                    <span>Minimum age</span>
                    <span class="spec">21</span>
                  </li>
                </ul>
                <div class="d-flex align-items-center bg-light p-3">
                  <span>RM400/day</span>
                  <a href="/auth/register" class="ml-auto btn btn-primary">Rent Now</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="site-section pt-0 pb-0 bg-light">
      <div class="container">
        <div class="row">
          <div class="col-12">
            
              <form class="trip-form">
                <div class="row align-items-center mb-4">
                  <div class="col-md-6">
                    <h3 class="m-0">Begin your trip here</h3>
                  </div>
                  <div class="col-md-6 text-md-right">
                    <span class="text-primary"><%= cars.length %></span> <span>cars available</span></span>
                  </div>
                </div>
                <div class="row">
                  <div class="form-group col-md-3">
                    <label for="cf-1">Where you from</label>
                    <input type="text" id="cf-1" placeholder="Your pickup address" class="form-control">
                  </div>
                  <div class="form-group col-md-3">
                    <label for="cf-2">Where you go</label>
                    <input type="text" id="cf-2" placeholder="Your drop-off address" class="form-control">
                  </div>
                  <div class="form-group col-md-3">
                    <label for="cf-3">Journey date</label>
                    <input type="text" id="cf-3" placeholder="Your pickup address" class="form-control datepicker px-3">
                  </div>
                  <div class="form-group col-md-3">
                    <label for="cf-4">Return date</label>
                    <input type="text" id="cf-4" placeholder="Your pickup address" class="form-control datepicker px-3">
                  </div>
                </div>
                <div class="row">
                  <div class="col-lg-6">
                    <input type="submit" value="Submit" class="btn btn-primary">
                  </div>
                </div>
              </form>
            </div>
        </div>
      </div>
    </div>

    

    <div class="site-section bg-light">
      <div class="container">
        <div class="row">
          <div class="col-lg-3">
            <h3>Our Offer</h3><p class="mb-4">Affordable rates, flexible rental terms, and well-maintained vehicles. Discover why thousands choose Carago for their travels.</p>
            
            <p>
              <a href="#" class="btn btn-primary custom-prev">Previous</a>
              <span class="mx-2">/</span>
              <a href="#" class="btn btn-primary custom-next">Next</a>
            </p>
          </div>
          
          <div class="col-lg-9">

            <div class="nonloop-block-13 owl-carousel">
              <% featuredCars.forEach(car => { %>
              <div class="item-1">
                <a href="/cars/<%= car.id %>"><img src="<%= car.img_url %>" alt="<%= car.brand %> <%= car.model %>" class="img-fluid"></a>
                <div class="item-1-contents">
                  <div class="text-center">
                  <h3><a href="/cars/<%= car.id %>"><%= car.brand %> <%= car.model %></a></h3>
                  <div class="rating">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <% if (i <= car.avgRating) { %>
                        <span class="icon-star text-warning"></span>
                      <% } else { %>
                        <span class="icon-star text-secondary"></span>
                      <% } %>
                    <% } %>
                  </div>
                  <div class="rent-price"><span>RM<%= car.pricePerDay %>/</span>day</div>
                  <% if (car.category === 'Luxury') { %>
                    <span class="badge badge-warning mb-2">Luxury</span>
                  <% } %>
                  <% if (car.bookingCount >= 2) { %>
                    <span class="badge badge-info mb-2">High Demand</span>
                  <% } %>
                  </div>
                  <div class="d-flex action">
                    <a href="/auth/register" class="btn btn-primary">Rent Now</a>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
            
          </div>
        </div>
      </div>
    </div>

    <div class="site-section section-3" style="background-image: url('/customer-assets/images/carago-services.jpg');">
      <div class="container">
        <div class="row">
          <div class="col-12 text-center mb-5">
            <h2 class="text-white">Our services</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4">
            <div class="service-1">
              <span class="service-1-icon">
                <span class="flaticon-car-1"></span>
              </span>
              <div class="service-1-contents">
                <h3>Premium Cleaning</h3>
                <p>Every vehicle is professionally cleaned and sanitized before each rental.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="service-1">
              <span class="service-1-icon">
                <span class="flaticon-traffic"></span>
              </span>
              <div class="service-1-contents">
                <h3>Full Insurance</h3>
                <p>Comprehensive insurance coverage for complete peace of mind on your journey.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="service-1">
              <span class="service-1-icon">
                <span class="flaticon-valet"></span>
              </span>
              <div class="service-1-contents">
                <h3>Own a Car</h3>
                <p>Flexible ownership programs with easy financing and insurance options.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/how-it-work') %>
    
    <div class="site-section bg-light">
      <div class="container">
        <div class="row justify-content-center text-center mb-5">
          <div class="col-7 text-center mb-5">
            <h2>Customer Testimony</h2>
            <p>Hear what our satisfied customers have to say about their experience with CarRent. Your trust is our priority!</p>
          </div>
        </div>
        <div class="row">
          <% if (reviews && reviews.length > 0) { %>
            <% reviews.slice(0, 3).forEach((review, index) => { %>
              <div class="col-lg-4 mb-4 mb-lg-0">
                <div class="testimonial-2">
                  <blockquote class="mb-4">
                    <p>"<%= review.comment %>"</p>
                  </blockquote>
                  <div class="d-flex v-card align-items-center">
                    <div class="testimonial-avatar mr-3">
                      <span class="avatar-initials"><%= review.userInitials %></span>
                    </div>
                    <div>
                      <span class="d-block font-weight-bold"><%= review.userName %></span>
                      <div class="review-stars">
                        <% for(let i = 1; i <= 5; i++) { %>
                          <% if (i <= review.rating) { %>
                            <i class="fas fa-star text-warning"></i>
                          <% } else { %>
                            <i class="far fa-star text-warning"></i>
                          <% } %>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-lg-4 mb-4 mb-lg-0">
              <div class="testimonial-2">
                <blockquote class="mb-4">
                  <p>"Amazing service! The car was in perfect condition and the booking process was incredibly smooth. I'll definitely rent from Carago again for my next trip."</p>
                </blockquote>
                <div class="d-flex v-card align-items-center">
                  <div class="testimonial-avatar mr-3">
                    <span class="avatar-initials">MF</span>
                  </div>
                  <span>Mike Fisher</span>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>


    <div class="site-section bg-white">
      <div class="container">
        <div class="row justify-content-center text-center mb-5">
          <div class="col-7 text-center mb-5">
            <h2>Our Blog</h2>
            <p>From travel tips to car care guides, explore articles that help you get the most out of every journey.</p>
          </div>
        </div>

        <div class="row">
          <% if (blogs && blogs.length > 0) { %>
            <% blogs.forEach((blog) => { %>
              <div class="col-lg-4 col-md-6 mb-4">
                <div class="post-entry-1 h-100">
                  <a href="/blog/<%= blog.slug %>">
                    <img src="<%= blog.featuredImage %>" alt="<%= blog.title %>" class="img-fluid">
                  </a>
                  <div class="post-entry-1-contents">
                    <h2><a href="/blog/<%= blog.slug %>"><%= blog.title %></a></h2>
                    <span class="meta d-inline-block mb-3"><%= blog.formattedCreatedAt %> <span class="mx-2">by</span> <a href="#"><%= blog.authorName %></a></span>
                    <p><%= blog.excerpt %></p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center">
              <p class="text-muted">No blog posts available at the moment.</p>
            </div>
          <% } %>
        </div>

        <% if (blogs && blogs.length > 0) { %>
          <div class="row mt-4">
            <div class="col-12 text-center">
              <a href="/blog" class="btn btn-primary">View All Blog Posts</a>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <%- include('./partials/footer') %>

    </div>

    <%- include('./partials/script') %>

  </body>

</html>

