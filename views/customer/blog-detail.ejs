<!doctype html>
<html lang="en">

  <%- include('./partials/head') %>

  <body data-spy="scroll" data-target=".site-navbar-target" data-offset="300">


    <div class="site-wrap" id="home-section">

      <div class="site-mobile-menu site-navbar-target">
        <div class="site-mobile-menu-header">
          <div class="site-mobile-menu-close mt-3">
            <span class="icon-close2 js-menu-toggle"></span>
          </div>
        </div>
        <div class="site-mobile-menu-body"></div>
      </div>

      <%- include('./partials/topbar') %>

    <div class="ftco-blocks-cover-1">
      <div class="ftco-cover-1 overlay innerpage" style="background-image: url('<%= blog.featuredImage %>')">
        <div class="container">
          <div class="row align-items-center justify-content-center">
            <div class="col-lg-8 text-center">
              <h1><%= blog.title %></h1>
              <p class="mb-0">
                <span class="mx-2"><i class="fa fa-calendar"></i> <%= blog.formattedCreatedAt %></span>
                <span class="mx-2"><i class="fa fa-user"></i> By <%= blog.authorName %></span>
                <span class="mx-2"><i class="fa fa-folder"></i> <%= blog.category %></span>
                <span class="mx-2"><i class="fa fa-eye"></i> <%= blog.views %> views</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="site-section bg-light">
      <div class="container">
        <div class="row">
          <!-- Blog Content -->
          <div class="col-lg-8">
            <div class="bg-white p-5 mb-4">
              <div class="mb-4">
                <img src="<%= blog.featuredImage %>" alt="<%= blog.title %>" class="img-fluid rounded"
                     onerror="this.src='/customer-assets/images/post_1.jpg'">
              </div>

              <div class="blog-content">
                <%- blog.content %>
              </div>

              <div class="mt-5 pt-4 border-top">
                <div class="d-flex align-items-center">
                  <div>
                    <span class="badge badge-primary mr-2"><%= blog.category %></span>
                    <span class="text-muted"><i class="fa fa-eye"></i> <%= blog.views %> views</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="col-lg-4">
            <!-- Author Info -->
            <div class="bg-white p-4 mb-4">
              <h5 class="mb-3">About the Author</h5>
              <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                     style="width: 60px; height: 60px; font-size: 24px;">
                  <%= blog.authorName.charAt(0) %>
                </div>
                <div class="ml-3">
                  <h6 class="mb-0"><%= blog.authorName %></h6>
                  <small class="text-muted">CARAGO Team Member</small>
                </div>
              </div>
            </div>

            <!-- Related Posts -->
            <% if (relatedBlogs && relatedBlogs.length > 0) { %>
              <div class="bg-white p-4 mb-4">
                <h5 class="mb-3">Related Articles</h5>
                <% relatedBlogs.forEach(related => { %>
                  <div class="mb-3 pb-3 border-bottom">
                    <a href="/blog/<%= related.slug %>" class="text-dark">
                      <h6 class="mb-1"><%= related.title %></h6>
                    </a>
                    <small class="text-muted">
                      <i class="fa fa-calendar"></i> <%= related.formattedCreatedAt %>
                    </small>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <!-- Back to Blog -->
            <div class="bg-white p-4">
              <a href="/blog" class="btn btn-primary btn-block">
                <i class="fa fa-arrow-left"></i> Back to All Articles
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/how-it-work') %>

    <%- include('./partials/footer') %>

    </div>

    <%- include('./partials/script') %>

  </body>

</html>
