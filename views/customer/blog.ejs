<!doctype html>
<html lang="en">

  <%- include('./partials/head') %>

  <body data-spy="scroll" data-target=".site-navbar-target" data-offset="300">

    
    <div class="site-wrap" id="home-section">

      <div class="site-mobile-menu site-navbar-target">
        <div class="site-mobile-menu-header">
          <div class="site-mobile-menu-close mt-3">
            <span class="icon-close2 js-menu-toggle"></span>
          </div>
        </div>
        <div class="site-mobile-menu-body"></div>
      </div>

      <%- include('./partials/topbar') %>

    <div class="ftco-blocks-cover-1">
      <div class="ftco-cover-1 overlay innerpage" style="background-image: url('/customer-assets/images/carago-blog.jpg')">
        <div class="container">
          <div class="row align-items-center justify-content-center">
            <div class="col-lg-6 text-center">
              <h1>Car Articles</h1>
              <p>Stay updated with the latest news, tips, and insights about car rentals</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="site-section bg-light">
      <div class="container">
        <div class="row">
          <% if (blogs && blogs.length > 0) { %>
            <% blogs.forEach(blog => { %>
              <div class="col-lg-4 col-md-6 mb-4">
                <div class="post-entry-1 h-100">
                  <a href="/blog/<%= blog.slug %>">
                    <img src="<%= blog.featuredImage %>" alt="<%= blog.title %>" class="img-fluid"
                         onerror="this.src='/customer-assets/images/post_1.jpg'">
                  </a>
                  <div class="post-entry-1-contents">
                    <h2><a href="/blog/<%= blog.slug %>"><%= blog.title %></a></h2>
                    <span class="meta d-inline-block mb-3">
                      <%= blog.formattedCreatedAt %> <span class="mx-2">by</span>
                      <a href="#"><%= blog.authorName %></a> <span class="mx-2">•</span>
                      <span class="badge badge-secondary"><%= blog.category %></span>
                    </span>
                    <p><%= blog.excerpt %></p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center py-5">
              <h3>No blog posts available</h3>
              <p class="text-muted">Check back later for new content!</p>
            </div>
          <% } %>

          <!-- Pagination -->
          <div class="col-12">
            <% if (totalPages > 1) { %>
              <nav class="pagination-container">
                <ul class="modern-pagination">
                  <!-- Previous Button -->
                  <li>
                    <% if (page > 1) { %>
                      <a href="?page=<%= page - 1 %>" class="page-link-custom">
                        <i class="icon-keyboard_arrow_left"></i>
                      </a>
                    <% } else { %>
                      <span class="page-link-custom disabled">
                        <i class="icon-keyboard_arrow_left"></i>
                      </span>
                    <% } %>
                  </li>

                  <!-- Page Numbers -->
                  <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) { %>
                      <li>
                        <% if (i === page) { %>
                          <span class="page-link-custom active"><%= i %></span>
                        <% } else { %>
                          <a href="?page=<%= i %>" class="page-link-custom"><%= i %></a>
                        <% } %>
                      </li>
                    <% } else if (i === page - 2 || i === page + 2) { %>
                      <li>
                        <span class="page-link-custom page-ellipsis">...</span>
                      </li>
                    <% } %>
                  <% } %>

                  <!-- Next Button -->
                  <li>
                    <% if (page < totalPages) { %>
                      <a href="?page=<%= page + 1 %>" class="page-link-custom">
                        <i class="icon-keyboard_arrow_right"></i>
                      </a>
                    <% } else { %>
                      <span class="page-link-custom disabled">
                        <i class="icon-keyboard_arrow_right"></i>
                      </span>
                    <% } %>
                  </li>
                </ul>
              </nav>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/how-it-work') %>

    <%- include('./partials/footer') %>

    </div>

    <%- include('./partials/script') %>

  </body>

</html>

