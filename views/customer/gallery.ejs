<!doctype html>
<html lang="en">

  <%- include('./partials/head') %>

  <body data-spy="scroll" data-target=".site-navbar-target" data-offset="300">

    <div class="site-wrap" id="home-section">

      <div class="site-mobile-menu site-navbar-target">
        <div class="site-mobile-menu-header">
          <div class="site-mobile-menu-close mt-3">
            <span class="icon-close2 js-menu-toggle"></span>
          </div>
        </div>
        <div class="site-mobile-menu-body"></div>
      </div>

      <%- include('./partials/topbar') %>

      <div class="ftco-blocks-cover-1">
        <div class="ftco-cover-1 overlay innerpage" style="background-image: url('/customer-assets/images/hero_2.jpg')">
          <div class="container">
            <div class="row align-items-center justify-content-center">
              <div class="col-lg-6 text-center">
                <h1>Our Gallery</h1>
                <p>Browse our curated collections of photos.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="site-section">
        <div class="container">
          <div class="row">
            <% if (galleries.length === 0) { %>
              <div class="col-12 text-center py-5">
                <p class="text-muted">No galleries available yet.</p>
              </div>
            <% } %>
            <% galleries.forEach(gallery => { %>
            <div class="col-lg-4 col-md-6 mb-4">
              <a href="/gallery/<%= gallery.id %>" style="text-decoration:none;color:inherit;">
                <div class="card h-100 shadow-sm">
                  <% if (gallery.coverImage) { %>
                    <img src="<%= gallery.coverImage %>" class="card-img-top" style="height:200px;object-fit:cover;" alt="<%= gallery.title %>">
                  <% } else { %>
                    <div style="height:200px;background:#eee;display:flex;align-items:center;justify-content:center;">
                      <i class="fas fa-images fa-3x text-muted"></i>
                    </div>
                  <% } %>
                  <div class="card-body">
                    <h5 class="card-title"><%= gallery.title %></h5>
                    <% if (gallery.description) { %>
                      <p class="card-text text-muted small"><%= gallery.description.substring(0, 100) %><%= gallery.description.length > 100 ? '...' : '' %></p>
                    <% } %>
                    <span class="btn btn-sm btn-outline-primary mt-2">View Gallery</span>
                  </div>
                </div>
              </a>
            </div>
            <% }) %>
          </div>
        </div>
      </div>

      <%- include('./partials/footer') %>

    </div>

    <%- include('./partials/script') %>

  </body>
</html>
