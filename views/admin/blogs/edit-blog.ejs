<!DOCTYPE html>
<html lang="en">

<%- include('../partials/header-sidebar') %>

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- Main Content -->
        <div id="content">

            <%- include('../partials/topbar') %>

                <!-- Gemini Content Row -->
                <div class="container-fluid py-4">

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h3>Edit Blog Post</h3>
                        <a href="/admin/blogs/list" class="text-decoration-none text-secondary">
                            <i class="fa-solid fa-arrow-left me-2"></i> Back to Blogs
                        </a>
                    </div>

                    <form action="/admin/blogs/edit/<%= oldData.id %>" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="row g-4">

                            <div class="col-lg-8">
                                <div class="card-custom">
                                    <h5><i class="fa-solid fa-newspaper me-2 text-primary"></i> Blog Content</h5>
                                    <hr style="border-color: #f1f3f5; margin-bottom: 25px;">
                                    <div class="row g-3">
                                        <div class="form-group col-12">
                                            <label for="title">Title</label>
                                            <input type="text" class="form-control" id="title" name="title"
                                                value="<%= oldData.title %>" required>
                                        </div>

                                        <div class="form-group col-12">
                                            <label for="excerpt">Excerpt</label>
                                            <textarea class="form-control" id="excerpt" name="excerpt" rows="2" required><%= oldData.excerpt %></textarea>
                                            <small class="text-muted">Brief description shown in blog list</small>
                                        </div>

                                        <div class="form-group col-12">
                                            <label for="content">Content</label>
                                            <textarea class="form-control" id="content" name="content" rows="12" required><%= oldData.content %></textarea>
                                            <small class="text-muted">You can use HTML tags for formatting</small>
                                        </div>

                                        <div class="form-group col-12 mt-5 d-flex justify-content-end">
                                            <a href="/admin/blogs/list" type="button" class="btn btn-secondary-custom">Cancel</a>
                                            <button type="submit" class="btn btn-primary-custom">
                                                <i class="fa-solid fa-save me-2"></i> Update Blog Post
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="card-custom">
                                    <h5><i class="fa-solid fa-cog me-2 text-primary"></i> Blog Settings</h5>
                                    <hr style="border-color: #f1f3f5; margin-bottom: 25px;">

                                    <div class="form-group">
                                        <label for="category">Category</label>
                                        <select class="form-control" id="category" name="category" required>
                                            <option value="Tips & Guides" <%= oldData.category === 'Tips & Guides' ? 'selected' : '' %>>Tips & Guides</option>
                                            <option value="Vehicle Insights" <%= oldData.category === 'Vehicle Insights' ? 'selected' : '' %>>Vehicle Insights</option>
                                            <option value="Travel & Destinations" <%= oldData.category === 'Travel & Destinations' ? 'selected' : '' %>>Travel & Destinations</option>
                                            <option value="Safety & Maintenance" <%= oldData.category === 'Safety & Maintenance' ? 'selected' : '' %>>Safety & Maintenance</option>
                                            <option value="Company News" <%= oldData.category === 'Company News' ? 'selected' : '' %>>Company News</option>
                                        </select>
                                    </div>

                                    <div class="form-group mt-3">
                                        <label for="status">Status</label>
                                        <select name="status" id="status" class="form-control" required>
                                            <option value="draft" <%= oldData.status === 'draft' ? 'selected' : '' %>>Draft</option>
                                            <option value="published" <%= oldData.status === 'published' ? 'selected' : '' %>>Published</option>
                                        </select>
                                    </div>

                                    <div class="form-group mt-3">
                                        <label for="featuredImage">Featured Image</label>
                                        <input type="file" class="form-control" id="featuredImage" name="featuredImage" accept="image/*">
                                        <small class="text-muted">Optional: Upload new featured image (Max 5MB)</small>
                                    </div>

                                    <div class="mt-3">
                                        <label>Current Image</label>
                                        <div class="image-preview-container">
                                            <img src="<%= oldData.featuredImage %>" alt="Current Featured Image" class="img-fluid rounded" style="max-height: 200px;">
                                        </div>
                                        <small class="text-muted d-block mt-2">Leave file input empty to keep current image</small>
                                    </div>

                                    <div class="mt-4 p-3" style="background-color: #f8f9fa; border-radius: 8px;">
                                        <small class="text-muted">
                                            <strong>Views:</strong> <%= oldData.views %><br>
                                            <strong>Created:</strong> <%= new Date(oldData.createdAt).toLocaleDateString() %>
                                        </small>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
                <!-- End of Main Content -->
                <%- include('../partials/footer') %>
        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <%- include('../partials/scripts') %>

</body>

</html>
