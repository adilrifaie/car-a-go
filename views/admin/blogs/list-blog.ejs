<!DOCTYPE html>
<html lang="en">

<%- include('../partials/header-sidebar') %>

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- Main Content -->
        <div id="content">

            <%- include('../partials/topbar') %>

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">
                            <%= title %>
                        </h1>
                        <a href="/admin/blogs/add" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                            <i class="fas fa-plus fa-sm text-white-50"></i> Add New Blog
                        </a>
                    </div>

                    <!-- Content Row -->
                    <div class="row">

                        <!-- Total Blogs Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-primary h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Total Blogs</p>
                                            <h2 class="card-value"><%= blogs.length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-primary">
                                            <i class="fas fa-newspaper fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Published Blogs Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-success h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Published</p>
                                            <h2 class="card-value"><%= blogs.filter(b => b.status === 'published').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-success">
                                            <i class="fas fa-check-circle fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Draft Blogs Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-warning h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Drafts</p>
                                            <h2 class="card-value"><%= blogs.filter(b => b.status === 'draft').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-warning">
                                            <i class="fas fa-file-alt fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total Views Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-info h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Total Views</p>
                                            <h2 class="card-value"><%= blogs.reduce((sum, b) => sum + b.views, 0) %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-info">
                                            <i class="fas fa-eye fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- DataTales Example -->
                    <div class="card shadow mb-4 mt-4">
                        <div class="card-body">
                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Title</th>
                                        <th>Author</th>
                                        <th>Category</th>
                                        <th>Views</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th style="text-align: center;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% blogs.forEach(blog => { %>
                                        <tr>
                                            <td class="col-id">#<%= blog.id %></td>
                                            <td>
                                                <div>
                                                    <span class="car-name-text"><%= blog.title %></span>
                                                    <span class="car-meta-text"><%= blog.excerpt.substring(0, 60) %>...</span>
                                                </div>
                                            </td>
                                            <td><%= blog.authorName %></td>
                                            <td><span class="badge badge-secondary"><%= blog.category %></span></td>
                                            <td><i class="fas fa-eye"></i> <%= blog.views %></td>
                                            <td>
                                                <% if (blog.status === 'published') { %>
                                                    <span class="badge badge-available">Published</span>
                                                <% } else if (blog.status === 'draft') { %>
                                                    <span class="badge badge-maintenance">Draft</span>
                                                <% } %>
                                            </td>
                                            <td><%= blog.formattedCreatedAt %></td>
                                            <td style="text-align: center;">
                                                <a class="action-btn btn-edit" title="Edit"
                                                    href="/admin/blogs/edit/<%= blog.id %>"><i
                                                        class="fa-solid fa-pen-to-square"></i></a>
                                                <a class="action-btn btn-delete" title="Delete"
                                                    data-id="<%= blog.id %>"
                                                    data-name="<%= blog.title %>"><i
                                                        class="fa-solid fa-trash-can"></i></a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /.container-fluid -->
                </div>
        </div>
        <!-- End of Main Content -->
        <%- include('../partials/footer') %>
    </div>
    <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <%- include('../partials/scripts.ejs') %>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteCarModal" tabindex="-1" role="dialog" aria-labelledby="deleteCarModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteCarModalLabel">Delete Blog</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong id="blogName"></strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <form id="deleteForm" method="POST" action="/admin/blogs/delete">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="blogId" id="blogId">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteButtons = document.querySelectorAll('.btn-delete');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const blogId = this.getAttribute('data-id');
                    const blogName = this.getAttribute('data-name');

                    document.getElementById('blogId').value = blogId;
                    document.getElementById('blogName').textContent = blogName;

                    $('#deleteCarModal').modal('show');
                });
            });
        });
    </script>

</body>

</html>
