<!DOCTYPE html>
<html lang="en">

<%- include('../partials/header-sidebar') %>

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- Main Content -->
        <div id="content">

            <%- include('../partials/topbar') %>

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">
                            <%= title %>
                        </h1>
                    </div>

                    <!-- Content Row -->
                    <div class="row">

                        <!-- Total Fleet Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-primary h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Total Fleet</p>
                                            <h2 class="card-value"><%= cars.length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-primary">
                                            <i class="fas fa-solid fa-car fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Available Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-success h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Available</p>
                                            <h2 class="card-value"><%= cars.filter(car=> car.status === 'Available').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-success">
                                            <i class="fa-solid fa-circle-check fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- On Rent Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-danger h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">On Rent</p>
                                            <h2 class="card-value"><%= cars.filter(car=> car.status === 'Rented').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-danger">
                                            <i class="fa-solid fa-route fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Maintenance Card -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card stats-card border-left-warning h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">In Shop</p>
                                            <h2 class="card-value"><%= cars.filter(car=> car.status === 'Maintenance').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-warning">
                                            <i class="fa-solid fa-screwdriver-wrench fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Row -->
                    <div class="car-list-container mt-5">

                        <div class="table-card">

                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Car Details</th>
                                        <th>Price</th>
                                        <th>Status</th>
                                        <th style="text-align: center;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% cars.forEach(element=> { %>
                                        <tr>
                                            <td class="col-id">#<%= element.id %>
                                            </td>
                                            <td>
                                                <div class="car-details-flex">
                                                    <img src="<%= element.img_url %>"
                                                        alt="<%= element.brand + ' ' + element.model %>"
                                                        class="thumbnail-img">
                                                    <div>
                                                        <span class="car-name-text">
                                                            <%= element.brand + ' ' + element.model %>
                                                        </span>
                                                        <span class="car-meta-text">
                                                            <%= element.year + ' • ' + element.category %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="price-text">RM<%= element.pricePerDay %></span><span
                                                    class="price-suffix">/day</span></td>
                                            <td>
                                                <% if (element.status === "Available") { %>
                                                    <span class="badge badge-available">Available</span>
                                                <% } else if (element.status === "Rented") { %>
                                                    <span class="badge badge-rented">Rented</span>
                                                <% } else if (element.status === "Maintenance") { %>
                                                    <span class="badge badge-maintenance">In Shop</span>
                                                <% } %>
                                            </td>
                                            <td style="text-align: center;">
                                                <a class="action-btn btn-edit" title="Edit"
                                                    href="/admin/cars/edit/<%= element.id %>"><i
                                                        class="fa-solid fa-pen-to-square"></i></a>
                                                <a class="action-btn btn-delete" title="Delete"
                                                    data-id="<%= element.id %>"
                                                    data-name="<%= element.brand + ' ' + element.model %>"><i
                                                        class="fa-solid fa-trash-can"></i></a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /.container-fluid -->
                </div>
        </div>
        <!-- End of Main Content -->
        <%- include('../partials/footer') %>
    </div>
    <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <%- include('../partials/scripts.ejs') %>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteCarModal" tabindex="-1" role="dialog" aria-labelledby="deleteCarModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteCarModalLabel">Delete Car</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <form action="/admin/cars/delete" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="modal-body">
                        <p class="fw-bold">Car ID: <span id="carId" class="fw-semibold"></span></p>
                        <p class="fw-bold">Car Name: <span id="carName" class="fw-semibold"></span></p>
                        <p class="text-danger fw-bold mt-3">Are you sure you want to delete this car?</p>
                        <input type="hidden" value="" id="deleteCarId" name="carId">
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Handle delete button clicks
        document.querySelectorAll('.btn-delete').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const carId = this.getAttribute('data-id');
                const carName = this.getAttribute('data-name');
                
                // Set modal content
                document.getElementById('carId').textContent = carId;
                document.getElementById('carName').textContent = carName;
                document.getElementById('deleteCarId').value = carId;
                
                // Show modal using jQuery (Bootstrap 4)
                $('#deleteCarModal').modal('show');
            });
        });
    </script>

    

</body>

</html>