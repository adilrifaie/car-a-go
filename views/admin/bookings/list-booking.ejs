<!DOCTYPE html>
<html lang="en">

<%- include('../partials/header-sidebar') %>

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- Main Content -->
        <div id="content">

            <%- include('../partials/topbar') %>

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">
                            <%= title %>
                        </h1>
                        <a href="/admin/bookings/add" class="btn btn-primary">
                            <i class="fas fa-plus fa-sm"></i> Add New Booking
                        </a>
                    </div>

                    <!-- Content Row -->
                    <div class="row">

                        <!-- Total Bookings Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-primary h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Total Bookings</p>
                                            <h2 class="card-value"><%= bookings.length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-primary">
                                            <i class="fas fa-calendar-check fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pending Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-warning h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Pending</p>
                                            <h2 class="card-value"><%= bookings.filter(b=> b.status === 'Pending').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-warning">
                                            <i class="fa-solid fa-hourglass-half fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Approved Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-success h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Active</p>
                                            <h2 class="card-value"><%= bookings.filter(b=> b.status === 'Approved').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-success">
                                            <i class="fa-solid fa-circle-check fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cancelled Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-danger h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Cancelled</p>
                                            <h2 class="card-value"><%= bookings.filter(b=> b.status === 'Cancelled').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-danger">
                                            <i class="fa-solid fa-ban fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Row -->
                    <div class="car-list-container mt-5">

                        <div class="table-card">

                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>Car Details</th>
                                        <th>Customer</th>
                                        <th>Dates</th>
                                        <th>Status</th>
                                        <th>Price</th>
                                        <th style="text-align: center;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% bookings.forEach(element=> { %>
                                        <tr>
                                            <td>
                                                <div class="car-details-flex">
                                                    <img src="<%= element.carImage %>"
                                                        alt="<%= element.carBrand + ' ' + element.carModel %>"
                                                        class="thumbnail-img"
                                                        onerror="this.onerror=null; this.src='/customer-assets/img/proton-x70.jpeg'">
                                                    <div>
                                                        <span class="car-name-text">
                                                            <%= element.carBrand %> <%= element.carModel %>
                                                        </span>
                                                        <span class="car-meta-text">
                                                            <%= element.carCategory %> • Auto
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <span class="car-name-text">
                                                        <%= element.userName %>
                                                    </span>
                                                    <span class="car-meta-text">
                                                        <%
                                                        let prefix = 'USR';
                                                        if (element.userRole === 'admin') prefix = 'ADM';
                                                        else if (element.userRole === 'staff') prefix = 'STF';
                                                        %>
                                                        #<%= prefix %>-<%= String(element.user_id).padStart(4, '0') %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <span class="car-name-text">
                                                        <%= element.dateRange %>
                                                    </span>
                                                    <span class="car-meta-text">
                                                        <%= element.totalDays %> Day<%= element.totalDays !== 1 ? 's' : '' %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (element.status === "Approved") { %>
                                                    <span class="badge badge-success">Approved</span>
                                                <% } else if (element.status === "Pending") { %>
                                                    <span class="badge badge-warning">Pending</span>
                                                <% } else if (element.status === "Cancelled") { %>
                                                    <span class="badge badge-danger">Cancelled</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="price-text">RM <%= element.totalPrice.toLocaleString() %></span>
                                            </td>
                                            <td style="text-align: center;">
                                                <a class="action-btn btn-edit" title="Edit"
                                                    href="/admin/bookings/edit/<%= element.id %>"><i
                                                        class="fa-solid fa-pen-to-square"></i></a>
                                                <a class="action-btn btn-delete" title="Delete"
                                                    data-id="<%= element.id %>"
                                                    data-name="<%= element.carBrand + ' ' + element.carModel + ' - ' + element.userName %>"><i
                                                        class="fa-solid fa-trash-can"></i></a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /.container-fluid -->
                </div>
        </div>
        <!-- End of Main Content -->
        <%- include('../partials/footer') %>
    </div>
    <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <%- include('../partials/scripts.ejs') %>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteBookingModal" tabindex="-1" role="dialog" aria-labelledby="deleteBookingModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteBookingModalLabel">Delete Booking</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <form action="/admin/bookings/delete" method="POST">
                    <div class="modal-body">
                        <p class="fw-bold">Booking ID: <span id="bookingId" class="fw-semibold"></span></p>
                        <p class="fw-bold">Booking Details: <span id="bookingName" class="fw-semibold"></span></p>
                        <p class="text-danger fw-bold mt-3">Are you sure you want to delete this booking?</p>
                        <input type="hidden" value="" id="deleteBookingId" name="bookingId">
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Handle delete button clicks
        document.querySelectorAll('.btn-delete').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const bookingId = this.getAttribute('data-id');
                const bookingName = this.getAttribute('data-name');

                // Set modal content
                document.getElementById('bookingId').textContent = bookingId;
                document.getElementById('bookingName').textContent = bookingName;
                document.getElementById('deleteBookingId').value = bookingId;

                // Show modal using jQuery (Bootstrap 4)
                $('#deleteBookingModal').modal('show');
            });
        });
    </script>

</body>

</html>
