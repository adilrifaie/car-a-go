<!DOCTYPE html>
<html lang="en">

<%- include('../partials/header-sidebar') %>

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- Main Content -->
        <div id="content">

            <%- include('../partials/topbar') %>

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">
                            <%= title %>
                        </h1>
                        <a href="/admin/users/add" class="btn btn-primary">
                            <i class="fas fa-plus fa-sm"></i> Add New User
                        </a>
                    </div>

                    <!-- Content Row -->
                    <div class="row">

                        <!-- Total Users Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-primary h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Total Users</p>
                                            <h2 class="card-value"><%= users.length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-primary">
                                            <i class="fas fa-users fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Admins Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-danger h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Admins</p>
                                            <h2 class="card-value"><%= users.filter(user=> user.role === 'admin').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-danger">
                                            <i class="fa-solid fa-user-shield fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Staff Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-warning h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Staff</p>
                                            <h2 class="card-value"><%= users.filter(user=> user.role === 'staff').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-warning">
                                            <i class="fa-solid fa-user-tie fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Customers Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card stats-card border-left-success h-100 py-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <p class="card-label mb-1">Customers</p>
                                            <h2 class="card-value"><%= users.filter(user=> user.role === 'customer').length %></h2>
                                        </div>
                                        <div class="col-auto icon-box icon-box-success">
                                            <i class="fa-solid fa-user fa-2x text-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Row -->
                    <div class="car-list-container mt-5">

                        <div class="table-card">

                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>User Details</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th style="text-align: center;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(element=> { %>
                                        <tr>
                                            <td class="col-id">#<%= element.id %>
                                            </td>
                                            <td>
                                                <div class="car-details-flex">
                                                    <div class="user-avatar">
                                                        <i class="fas fa-user-circle fa-3x text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <span class="car-name-text">
                                                            <%= element.firstName + ' ' + element.lastName %>
                                                        </span>
                                                        <span class="car-meta-text">
                                                            ID: <%= element.id %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="email-text"><%= element.email %></span></td>
                                            <td>
                                                <% if (element.role === "admin") { %>
                                                    <span class="badge badge-danger">Admin</span>
                                                <% } else if (element.role === "staff") { %>
                                                    <span class="badge badge-warning">Staff</span>
                                                <% } else if (element.role === "customer") { %>
                                                    <span class="badge badge-success">Customer</span>
                                                <% } %>
                                            </td>
                                            <td style="text-align: center;">
                                                <a class="action-btn btn-delete" title="Delete"
                                                    data-id="<%= element.id %>"
                                                    data-name="<%= element.firstName + ' ' + element.lastName %>"><i
                                                        class="fa-solid fa-trash-can"></i></a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /.container-fluid -->
                </div>
        </div>
        <!-- End of Main Content -->
        <%- include('../partials/footer') %>
    </div>
    <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <%- include('../partials/scripts.ejs') %>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteUserModal" tabindex="-1" role="dialog" aria-labelledby="deleteUserModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteUserModalLabel">Delete User</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <form action="/admin/users/delete" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="modal-body">
                        <p class="fw-bold">User ID: <span id="userId" class="fw-semibold"></span></p>
                        <p class="fw-bold">User Name: <span id="userName" class="fw-semibold"></span></p>
                        <p class="text-danger fw-bold mt-3">Are you sure you want to delete this user?</p>
                        <input type="hidden" value="" id="deleteUserId" name="userId">
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Handle delete button clicks
        document.querySelectorAll('.btn-delete').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const userId = this.getAttribute('data-id');
                const userName = this.getAttribute('data-name');

                // Set modal content
                document.getElementById('userId').textContent = userId;
                document.getElementById('userName').textContent = userName;
                document.getElementById('deleteUserId').value = userId;

                // Show modal using jQuery (Bootstrap 4)
                $('#deleteUserModal').modal('show');
            });
        });
    </script>

    <style>
        .user-avatar {
            margin-right: 12px;
            display: flex;
            align-items: center;
        }

        .email-text {
            font-size: 14px;
            color: #5a5c69;
        }
    </style>

</body>

</html>
