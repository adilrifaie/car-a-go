<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/header-sidebar') %>

  <!-- Content Wrapper -->
  <div id="content-wrapper" class="d-flex flex-column">

    <!-- Main Content -->
    <div id="content">
      <%- include('./partials/topbar') %>

      <!-- Begin Page Content -->
      <div class="container-fluid">

        <!-- 404 Error Card -->
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="card shadow mb-4 mt-5">
              <div class="card-body text-center py-5">
                <div class="error mx-auto" data-text="404">
                  <p class="m-0" style="font-size: 7rem; font-weight: bold; color: #4e73df; white-space: nowrap;">404</p>
                </div>
                <p class="lead text-gray-800 mb-3">Page Not Found</p>
                <p class="text-gray-500 mb-4">
                  The page you are looking for doesn't exist or has been moved.
                </p>
                <a href="/admin" class="btn btn-primary">
                  <i class="fas fa-arrow-left mr-2"></i>Return to Dashboard
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
      <!-- /.container-fluid -->

    </div>
    <!-- End of Main Content -->

    <%- include('./partials/footer') %>

  </div>
  <!-- End of Content Wrapper -->

  <%- include('./partials/scripts') %>
</html>
